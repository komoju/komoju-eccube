{% extends '@admin/default_frame.twig' %}

{% set menus = ['Komoju', 'Komoju_config'] %}

{% block title %}{{ 'komoju_payment.admin.config.title'|trans }}{% endblock %}
{% block sub_title %}{{ 'komoju_payment.admin.config.subtitle'|trans }}{% endblock %}


{% block stylesheet %}
<style>
.komoju-webhook-url {
    display: inline-block;
    padding: 0.4em 0.8em;
    background-color: #f8f9fa;
    border: 1px solid #dee2e6;
    border-radius: 4px;
    font-size: 0.9em;
    color: #495057;
    word-break: break-all;
    user-select: all;
}
.komoju-webhook-info {
    background-color: #f8f9fa;
    border: 1px solid #e9ecef;
    border-radius: 4px;
    padding: 1em 1.25em;
}
.komoju-webhook-events {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4em;
}
.komoju-webhook-events code {
    display: inline-block;
    padding: 0.25em 0.6em;
    background-color: #e9ecef;
    border-radius: 3px;
    font-size: 0.85em;
    color: #495057;
}
.komoju-pay-badge {
    display: inline-block;
    font-size: 0.85em;
    font-weight: normal;
    padding: 0.35em 0.7em;
    background-color: #e9ecef;
    color: #333;
    border-radius: 3px;
    margin: 0 0.25em 0.35em 0;
}
.clip-board-btn { color: #53aee0; cursor: pointer; }
.clip-board-btn:hover { color: #185d82; }
.komoju-secret-field {
    position: relative;
    display: flex;
    align-items: center;
}
.komoju-secret-field .form-control {
    padding-right: 2.5em;
}
.komoju-secret-toggle {
    color: #6c757d;
    cursor: pointer;
    margin-left: 0.5em;
}
.komoju-secret-toggle:hover { color: #495057; }
</style>
{% endblock stylesheet %}

{% block main %}

{% form_theme form '@admin/Form/bootstrap_4_horizontal_layout.html.twig' %}

    <form role="form" method="post">
    {{ form_widget(form._token) }}
        <div class="c-contentsArea__cols">
            <div class="c-contentsArea__primaryCol">
                <div class="c-primaryCol">

                    {# Card 1: API Credentials #}
                    <div class="card rounded border-0 mb-4">
                        <div class="card-header"><span>{{ 'komoju_payment.admin.config.section.credentials'|trans }}</span></div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-3">
                                    <span>{{ 'komoju_payment.admin.config.label:merchant_uuid'|trans }}</span>
                                    <span class="badge badge-primary ms-1">{{ 'komoju_payment.badge.required'|trans }}</span>
                                </div>
                                <div class="col mb-2">
                                    {{ form_widget(form.merchant_uuid) }}
                                    {{ form_errors(form.merchant_uuid) }}
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-3">
                                    <span>{{ 'komoju_payment.admin.config.label:secret_key'|trans }}</span>
                                    <span class="badge badge-primary ms-1">{{ 'komoju_payment.badge.required'|trans }}</span>
                                </div>
                                <div class="col mb-2">
                                    <div class="komoju-secret-field">
                                        {{ form_widget(form.secret_key) }}
                                        <span class="komoju-secret-toggle" data-target="{{ form.secret_key.vars.id }}"><i class="fas fa-eye"></i></span>
                                    </div>
                                    {{ form_errors(form.secret_key) }}
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-3">
                                    <span>{{ 'komoju_payment.admin.config.label:publishable_key'|trans }}</span>
                                    <span class="badge badge-primary ms-1">{{ 'komoju_payment.badge.required'|trans }}</span>
                                </div>
                                <div class="col mb-2">
                                    <div class="komoju-secret-field">
                                        {{ form_widget(form.publishable_key) }}
                                        <span class="komoju-secret-toggle" data-target="{{ form.publishable_key.vars.id }}"><i class="fas fa-eye"></i></span>
                                    </div>
                                    {{ form_errors(form.publishable_key) }}
                                </div>
                            </div>
                        </div>
                    </div>

                    {# Card 2: Payment Settings #}
                    <div class="card rounded border-0 mb-4">
                        <div class="card-header"><span>{{ 'komoju_payment.admin.config.section.payment'|trans }}</span></div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-3">
                                    <span>{{ 'komoju_payment.admin.config.label.capture_on'|trans }}</span>
                                    <span class="badge badge-primary ms-1">{{ 'komoju_payment.badge.required'|trans }}</span>
                                </div>
                                <div class="col mb-2">
                                    {{ form_widget(form.capture_on) }}
                                    {{ form_errors(form.capture_on) }}
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-3">
                                    <span>{{ 'komoju_payment.admin.config.label.komoju_pay_type'|trans }}</span>
                                </div>
                                <div class="col mb-2">
                                    {% if is_connected %}
                                        <div id="komoju-pay-methods" class="mb-2">
                                            {% for pay in komoju_pays %}
                                                <span class="komoju-pay-badge">{{ pay.dispName }}</span>
                                            {% endfor %}
                                        </div>
                                        <div class="mt-2">
                                            <button type="button" id="btn-sync-methods" class="btn btn-sm btn-outline-secondary">
                                                <i class="fas fa-sync-alt"></i> {{ 'komoju_payment.admin.config.refresh_methods'|trans }}
                                            </button>
                                            <span id="sync-status" class="ms-2" style="display:none;"></span>
                                        </div>
                                        <div class="mt-2 text-muted">
                                            {{ 'komoju_payment.admin.config.payment_settings_hint'|trans }}
                                            <a href="{{ url('admin_setting_shop_payment') }}">{{ 'komoju_payment.admin.config.payment_settings_link'|trans }}</a>
                                        </div>
                                    {% else %}
                                        <p class="text-muted mb-2">{{ 'komoju_payment.admin.config.connect_hint'|trans }}</p>
                                        <button type="button" id="btn-connect-komoju" class="btn btn-primary">
                                            <i class="fas fa-plug"></i> {{ 'komoju_payment.admin.config.connect_button'|trans }}
                                        </button>
                                        <span id="sync-status" class="ms-2" style="display:none;"></span>
                                    {% endif %}
                                </div>
                            </div>
                            <div class="row mt-4">
                                <div class="col-3">
                                    <span>{{ 'komoju_payment.admin.config.label.order_number_format'|trans }}</span>
                                    <i class="fa fa-question-circle fa-lg ms-1" data-bs-toggle="tooltip" data-bs-placement="top" title="{{ 'komoju_payment.admin.config.label.order_number_format_tooltip'|trans }}"></i>
                                </div>
                                <div class="col mb-2">
                                    {{ form_widget(form.order_number_format, { 'attr': { 'class': 'form-control', 'style': 'width:50%; display:inline-block;', 'placeholder': '{order_no}' } }) }}
                                    <div class="mt-1 text-muted">{{ 'komoju_payment.admin.config.label.order_number_format_hint'|trans }}</div>
                                    {{ form_errors(form.order_number_format) }}
                                </div>
                            </div>
                        </div>
                    </div>

                    {# Card 3: Webhook Configuration #}
                    <div class="card rounded border-0 mb-4">
                        <div class="card-header"><span>{{ 'komoju_payment.admin.config.section.webhook'|trans }}</span></div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-3">
                                    <span>{{ 'komoju_payment.admin.config.label:webhook_secret'|trans }}</span>
                                    <span class="badge badge-primary ms-1">{{ 'komoju_payment.badge.required'|trans }}</span>
                                </div>
                                <div class="col mb-2">
                                    {{ form_widget(form.webhook_secret, { 'attr' : { 'readonly' : true , 'style' : 'width:30%; display: inline;' } }) }}
                                    {{ form_errors(form.webhook_secret) }}
                                    <span class="clip-board-btn"><i class="fas fa-copy"></i></span>
                                </div>
                            </div>
                            <div class="row mt-3">
                                <div class="col-3"><span>{{ 'komoju_payment.admin.config.label.webhook_url'|trans }}</span></div>
                                <div class="col mb-2">
                                    <code class="komoju-webhook-url">{{ url('Komoju42_webhook') }}</code>
                                </div>
                            </div>
                            <div class="row mt-3">
                                <div class="col-3"></div>
                                <div class="col mb-2">
                                    <div class="komoju-webhook-info">
                                        <p class="mb-2">{{ 'komoju_payment.admin.config.webhook_check_notice'|trans }}</p>
                                        <p class="mb-3">
                                            <a href="https://komoju.com/merchant/webhooks" target="_blank">
                                                {{ 'komoju_payment.admin.config.webhook_dashboard'|trans }} <i class="fas fa-external-link-alt fa-sm"></i>
                                            </a>
                                        </p>
                                        <p class="mb-2">{{ 'komoju_payment.admin.config.webhook_events'|trans }}</p>
                                        <div class="komoju-webhook-events">
                                            <code>payment.authorized</code>
                                            <code>payment.captured</code>
                                            <code>payment.updated</code>
                                            <code>payment.expired</code>
                                            <code>payment.cancelled</code>
                                            <code>payment.refunded</code>
                                            <code>payment.failed</code>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    {# Card 4: Logging & Advanced #}
                    <div class="card rounded border-0 mb-4">
                        <div class="card-header"><span>{{ 'komoju_payment.admin.config.section.advanced'|trans }}</span></div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-3">
                                    <span>{{ 'komoju_payment.admin.config.label.logging_enabled'|trans }}</span>
                                </div>
                                <div class="col mb-2">
                                    <input type="checkbox" id="{{ form.logging_enabled.vars.id }}" name="{{ form.logging_enabled.vars.full_name }}" class="form-check-input" style="margin-left: 0; position: static;" value="1" {{ form.logging_enabled.vars.checked is defined and form.logging_enabled.vars.checked ? 'checked="checked"' : '' }}>
                                    <label class="form-check-label text-muted ms-1" for="{{ form.logging_enabled.vars.id }}">
                                        {{ 'komoju_payment.admin.config.label.logging_enabled_hint'|trans }}
                                    </label>
                                </div>
                            </div>
                            <div class="row mt-4">
                                <div class="col-3">
                                    <span>{{ 'komoju_payment.admin.config.label.log_retention_days'|trans }}</span>
                                    <i class="fa fa-question-circle fa-lg ms-1" data-bs-toggle="tooltip" data-bs-placement="top" title="{{ 'komoju_payment.admin.config.label.log_retention_days_tooltip'|trans }}"></i>
                                </div>
                                <div class="col mb-2">
                                    {{ form_widget(form.log_retention_days, { 'attr': { 'class': 'form-control', 'style': 'width:120px; display:inline-block;', 'placeholder': '90' } }) }}
                                    <span class="ms-2 text-muted">{{ 'komoju_payment.admin.config.label.log_retention_days_hint'|trans }}</span>
                                    {{ form_errors(form.log_retention_days) }}
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
        <div class="c-conversionArea">
            <div class="c-conversionArea__container">
                <div class="row justify-content-between align-items-center">
                    <div class="col-6">
                        <div class="c-conversionArea__leftBlockItem">
                            <a class="c-beseLink"
                                href="{{ url('admin_store_plugin') }}">
                                <i class="fa fa-backward" aria-hidden="true"></i>
                                <span>{{ 'komoju_payment.admin.config.back'|trans }}</span>
                            </a>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="row align-items-center justify-content-end">
                            <div class="col-auto">
                                <button class="btn btn-ec-conversion px-5"
                                        type="submit">{{ 'komoju_payment.admin.config.save'|trans }}</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
<script>
    $(function(){
        {% if form.webhook_secret is defined %}
        $(".clip-board-btn").click(function(){
            var secret_box = document.getElementById("{{ form.webhook_secret.vars.id }}");
            secret_box.select();
            document.execCommand('Copy');
        })
        {% endif %}

        function doSync(btn) {
            var status = $("#sync-status");
            var secretKey = $("#{{ form.secret_key.vars.id }}").val();
            if (!secretKey) {
                status.text("{{ 'komoju_payment.admin.config.error.secret_key.empty'|trans }}").css("color", "red").show();
                return;
            }
            btn.prop("disabled", true);
            btn.find("i").addClass("fa-spin");
            status.text("{{ 'komoju_payment.admin.config.sync_in_progress'|trans }}").css("color", "").show();

            $.ajax({
                url: "{{ url('Komoju42_admin_sync_methods') }}",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify({ secret_key: secretKey }),
                dataType: "json",
                headers: { "X-CSRF-Token": $("input[name='Komoju_config[_token]']").val() },
                success: function(data){
                    status.text("{{ 'komoju_payment.admin.config.sync_complete'|trans }}").css("color", "green");
                    setTimeout(function(){ location.reload(); }, 1000);
                },
                error: function(xhr){
                    var msg = "{{ 'komoju_payment.admin.config.connect_failed'|trans }}";
                    if(xhr.responseJSON && xhr.responseJSON.message){
                        msg = xhr.responseJSON.message;
                    }
                    status.text(msg).css("color", "red");
                    btn.prop("disabled", false);
                    btn.find("i").removeClass("fa-spin");
                }
            });
        }

        $(".komoju-secret-toggle").each(function(){
            document.getElementById($(this).data("target")).type = "password";
        });

        $(".komoju-secret-toggle").click(function(){
            var input = document.getElementById($(this).data("target"));
            var icon = $(this).find("i");
            if (input.type === "password") {
                input.type = "text";
                icon.removeClass("fa-eye").addClass("fa-eye-slash");
            } else {
                input.type = "password";
                icon.removeClass("fa-eye-slash").addClass("fa-eye");
            }
        });

        $("#btn-connect-komoju").click(function(){ doSync($(this)); });
        $("#btn-sync-methods").click(function(){ doSync($(this)); });
    });
</script>
{% endblock %}
