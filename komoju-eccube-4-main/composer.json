{
    "name": "ec-cube/komoju",
    "version": "1.1.0",
    "description": "KOMOJU決済プラグイン",
    "type": "eccube-plugin",
    "require": {
        "ec-cube/plugin-installer": "~0.0.6 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "config": {
        "allow-plugins": {
            "ec-cube/plugin-installer": true
        }
    },
    "autoload": {
        "psr-4": {
            "Plugin\\Komoju\\": "./"
        },
        "classmap": [
            "Resource/komoju_lib/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Komoju\\": "tests/"
        },
        "classmap": [
            "tests/Stubs/"
        ]
    },
    "extra": {
        "code": "Komoju"
    }
}
